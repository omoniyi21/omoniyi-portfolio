# Netlify Functions: SMTP credentials for the site's forms.
# Set these in Netlify > Site configuration > Environment variables.
# For local testing with `netlify dev`, copy this file to .env (not committed).
SMTP_USER=contact@omoniyialimi.com
SMTP_PASS=
# Optional: default to DreamHost (smtp.dreamhost.com, port 587)
SMTP_HOST=
SMTP_PORT=
