# Netlify Functions: SMTP credentials for the site's forms.
# Set these in Netlify > Site configuration > Environment variables.
# For local testing with `netlify dev`, copy this file to .env (not committed).
SMTP_USER=contact@omoniyialimi.com
SMTP_PASS=
# Optional: default to DreamHost (smtp.dreamhost.com, port 587)
SMTP_HOST=
SMTP_PORT=

# Private /tools area (sign-in by emailed link)
# TOOLS_ALLOWED_EMAIL: the address that may sign in (comma-separate to allow more than one).
# TOOLS_AUTH_SECRET: a long random string; generate with `openssl rand -base64 48`.
# Changing TOOLS_AUTH_SECRET signs out every device.
TOOLS_ALLOWED_EMAIL=
TOOLS_AUTH_SECRET=

# Planner: server-side Notion internal integration, with Read content access.
# Add the connection to OUTLOUD and its original source databases in Notion.
# Never use a VITE_ prefix for this secret.
NOTION_TOKEN=

# Client portal (omoniyistudio.com/portal, sign-in by emailed link)
# PORTAL_CLIENTS: email=project pairs, comma-separated. Each email opens /portal/<project>/ only.
#   e.g. PORTAL_CLIENTS=nawal@example.com=6ix,tae@example.com=taehamm
# The owner (TOOLS_ALLOWED_EMAIL) can open every room.
# PORTAL_AUTH_SECRET is optional; without it the portal signs with TOOLS_AUTH_SECRET
# (portal and tools tokens still can't be swapped for each other).
PORTAL_CLIENTS=
PORTAL_AUTH_SECRET=
# Optional Studio sender, e.g. hello@omoniyistudio.com on DreamHost. Falls back to SMTP_USER / SMTP_PASS.
PORTAL_SMTP_USER=
PORTAL_SMTP_PASS=
