# Netlify Functions: SMTP credentials for the site's forms.
# Set these in Netlify > Site configuration > Environment variables.
# For local testing with `netlify dev`, copy this file to .env (not committed).
SMTP_USER=contact@omoniyialimi.com
SMTP_PASS=
# Optional: default to DreamHost (smtp.dreamhost.com, port 587)
SMTP_HOST=
SMTP_PORT=

# Private /tools area (sign-in by emailed link)
# TOOLS_ALLOWED_EMAIL: the address that may sign in (comma-separate to allow more than one).
# TOOLS_AUTH_SECRET: a long random string; generate with `openssl rand -base64 48`.
# Changing TOOLS_AUTH_SECRET signs out every device.
TOOLS_ALLOWED_EMAIL=
TOOLS_AUTH_SECRET=
